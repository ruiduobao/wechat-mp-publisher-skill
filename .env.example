# ==============================================================================
# WeChat MP Publisher Skill - 环境变量配置示例 (.env.example)
# 复制本文件为 .env 后修改为你的本地目录与公众号配置（.env 已被 .gitignore 忽略，不会入库）
# ==============================================================================

# 1. Markdown 文章源目录（只读扫描，建议放在独立目录；目录内按 YYYYMMDD_HHMM 批次存放 .md）
# 只需要一个源目录时，可将另一个设为不存在或空目录
WECHAT_LOCAL_ROOT=./workspace/articles
WECHAT_MUSE_ROOT=./workspace/external_articles

# 2. 私有状态与缓存目录（绝不与源目录混放，也不要提交到 GitHub）
WECHAT_HISTORY_FILE=./private-data/wechat-draft-history.json
WECHAT_BASELINE_FILE=./private-data/wechat-legacy-baseline.json
WECHAT_LOCK_FILE=./private-data/wechat-publisher.lock
WECHAT_STATE_CACHE_DIR=./private-data/cache
WECHAT_TITLES_FILE=./private-data/titles-override.json
WECHAT_COVER_OVERRIDES_FILE=./private-data/cover-overrides.json

# 3. 公众号作者与原生名片设置
# 作者名称（填入后台“作者”输入框）
WECHAT_AUTHOR=你的公众号作者名

# 首次上手若暂未配置文末原生公众号名片，可设为 1 跳过名片插入与校验
WECHAT_SKIP_PROFILE_CARD=1

# 如需插入文末原生账号名片（mp-common-profile），将 WECHAT_SKIP_PROFILE_CARD=0 并填写下方信息：
# WECHAT_SKIP_PROFILE_CARD=0
# WECHAT_PROFILE_NAME=你的公众号名称
# WECHAT_PROFILE_DATA_ID=你的公众号base64_data_id
# WECHAT_PROFILE_DESC_KEYWORD=
# WECHAT_PROFILE_EXCLUDED=
# WECHAT_PROFILE_TEMPLATE_FILE=./private-data/native-card-template.html

# 4. 浏览器与运行时（可选，默认自动探测本机 Edge/Chrome 与 Bun）
# WECHAT_BROWSER_CHROME_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# WECHAT_BROWSER_PROFILE_DIR=./private-data/chrome-profile
# WECHAT_BUN_PATH=bun
